# Copy to .env with `pnpm env:local`. In Kubernetes: ConfigMap notifications-api-config
# and SealedSecret notifications-api-secrets (envFrom).
NODE_ENV=development
PORT=4200
LOG_LEVEL=info
APP_VERSION=dev
METRICS_PORT=9472
TRUST_PROXY_HOPS=0
SHUTDOWN_DELAY_MS=0

# Local dependencies of compose.yaml (pnpm infra:up).
DATABASE_URL=postgres://app:app@localhost:5442/app
DATABASE_POOL_MAX=10
RABBITMQ_URL=amqp://app:app@localhost:5682

ID_JWKS_URL=http://localhost:4100/.well-known/jwks.json
TOKEN_ISSUER=http://localhost:3100
TOKEN_AUDIENCE=nick-lukashik
ID_API_URL=http://localhost:4100
ID_WEB_URL=http://localhost:3100
# log: no provider, the email is dropped and nothing of it is logged. smtp needs SMTP_URL (smtp://user:pass@host:587).
MAIL_TRANSPORT=log
MAIL_FROM=nick-lukashik <no-reply@nick-lukashik.com>

# Secrets, never committed. INTERNAL_API_TOKEN = NOTIFICATIONS_INTERNAL_TOKEN of id-api;
# ID_INTERNAL_TOKEN = INTERNAL_API_TOKEN of id-api.
INTERNAL_API_TOKEN=
ID_INTERNAL_TOKEN=
SMTP_URL=
